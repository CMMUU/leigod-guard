# Generated values are local secrets. Do not commit server.env.
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
DATABASE_URL=postgres://guard:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/leigod_guard
# Exact browser origin, without trailing slash or path. Public use requires HTTPS.
PUBLIC_ORIGIN=http://127.0.0.1:3088
PORT=3088
LISTEN_ADDRESS=127.0.0.1
STATIC_DIR=./static
# Start in observation mode; enable only after HTTPS, backup and key setup.
REMOTE_EXECUTION=false
REMOTE_KEY_FILE=./secrets/remote.key
EMAIL_CODE_SECRET=REPLACE_EMAIL_SECRET
# Omit these two variables entirely to disable email login. Empty values are invalid.
# RESEND_API_KEY=re_your_own_key
# EMAIL_FROM='Leigod Guard <login@your-verified-domain.example>'
