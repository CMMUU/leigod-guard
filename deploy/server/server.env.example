# Generated values are local secrets. Do not commit server.env.
MYSQL_PASSWORD=REPLACE_DATABASE_PASSWORD
DATABASE_URL=mysql://guard:REPLACE_DATABASE_PASSWORD@127.0.0.1:3306/leigod_guard
# Exact browser origin, without trailing slash or path. Public use requires HTTPS.
PUBLIC_ORIGIN=http://127.0.0.1:3088
PORT=3088
LISTEN_ADDRESS=127.0.0.1
STATIC_DIR=./static
# Start in observation mode; enable only after HTTPS, backup and key setup.
REMOTE_EXECUTION=false
REMOTE_KEY_FILE=./secrets/remote.key
EMAIL_CODE_SECRET=REPLACE_EMAIL_SECRET
# Omit these two variables entirely to disable email login. Empty values are invalid.
# RESEND_API_KEY=re_your_own_key
# EMAIL_FROM='Leigod Guard <login@your-verified-domain.example>'

# testing (default), maintenance (API writes/workers stopped), or stable
SERVICE_STAGE=testing
# Remote MySQL requires TLS identity verification; use the provider CA when private.
# MYSQL_SSL_CA=/absolute/path/provider-ca.pem
# Certificates without SANs require a chain-verified, exact-leaf-pinned loopback
# relay with an independently trusted CA and pin. Never disable upstream TLS.
# See the project-docs deployment guide for the optional relay configuration.
# Only during managed migration: accept the old maintained IP origin.
# LEGACY_ORIGIN=https://111.229.216.86
